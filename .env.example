NODE_ENV=development
PORT=5000
TRUST_PROXY=0
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://username:password@cluster-host/MARVEXENERGY?authSource=admin&retryWrites=true&w=majority
ADMIN_NAME=Marvex CMS Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
